# Generate your own value: python3 -c 'import secrets;print(secrets.token_urlsafe(40))'
VPSDEPLOY_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_24_CHARS

# Internal token for the isolated AI worker
VPSDEPLOY_WORKER_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_24_CHARS
# Optional: only needed when enabling the ai compose profile
CODEX_API_KEY=

# 兼容说明: 本项目用 VPSDEPLOY_* 前缀。老版本用的是 NETDEPLOY_*,
